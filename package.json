{
  "name": "uecfi-presenter",
  "version": "1.0.0",
  "description": "UECFI Church Presentation & Worship Projection Software",
  "main": "main.js",
  "author": "UECFI",
  "license": "ISC",
  "type": "commonjs",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:css": "tailwindcss -i ./src/tailwind-input.css -o ./tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/tailwind-input.css -o ./tailwind.css --watch",
    "start": "electron .",
    "pack": "npm run build:css && electron-builder --dir",
    "dist": "npm run build:css && electron-builder",
    "dist:mac": "npm run build:css && electron-builder --mac",
    "dist:win": "npm run build:css && electron-builder --win"
  },
  "build": {
    "appId": "org.uecfi.presenter",
    "productName": "UECFI Presenter",
    "directories": {
      "output": "dist"
    },
    "asar": false,
    "files": [
      "**/*",
      "!**/*.map",
      "!**/*.py",
      "!**/*.sh",
      "!wordpress-plugin/**",
      "!src/**",
      "!tailwind.config.js",
      "!.github/**",
      "!dist/**"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "app-icon.png",
      "identity": null
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "app-icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "UECFI Presenter"
    }
  },
  "devDependencies": {
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^3.4.19"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
